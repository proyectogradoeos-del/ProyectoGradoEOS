<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="ir_cron_eos_meeting_reminders" model="ir.cron">
      <field name="name">EOS L10 Reminders</field>
      <field name="model_id" ref="model_eos_meeting"/>
      <field name="state">code</field>
      <field name="code">model.cron_send_pre_meeting_reminders()</field>
      <field name="active" eval="True"/>
      <field name="interval_number" eval="5"/>
      <field name="interval_type">minutes</field>
      <field name="numbercall" eval="-1"/>
      <field name="doall" eval="False"/>
    </record>
  </data>
</odoo>
